import crypto from 'node:crypto';

/**
 * تنظيف النص
 */
function clean(value) {
  if (value === null || value === undefined) return null;
  const v = String(value).trim();
  return v ? v : null;
}

/**
 * SHA256
 */
function sha256(value) {
  return crypto.createHash('sha256').update(value, 'utf8').digest('hex');
}

/**
 * تحويل الهاتف إلى صيغة دولية
 */
function normalizePhone(phone) {
  const v = clean(phone);
  if (!v) return null;

  let digits = v.replace(/[^\d]/g, '');

  if (digits.startsWith('00')) digits = digits.slice(2);

  if (digits.startsWith('0') && digits.length >= 9) {
    digits = '962' + digits.slice(1);
  }

  if (digits.length === 9 && digits.startsWith('7')) {
    digits = '962' + digits;
  }

  return digits;
}

/**
 * تحويل البريد
 */
function normalizeEmail(email) {
  const v = clean(email);
  if (!v) return null;
  return v.toLowerCase();
}

/**
 * بناء user_data
 */
function buildUserData(user = {}) {
  const data = {};

  if (user.phone) {
    const phone = normalizePhone(user.phone);
    if (phone) data.ph = [sha256(phone)];
  }

  if (user.email) {
    const email = normalizeEmail(user.email);
    if (email) data.em = [sha256(email)];
  }

  if (user.firstName) {
    data.fn = [sha256(user.firstName.toLowerCase())];
  }

  if (user.city) {
    data.ct = [sha256(user.city.toLowerCase())];
  }

  return data;
}

/**
 * إرسال الحدث إلى Meta
 */
export async function sendMetaEvent(appConfig, event = {}) {
  try {
    const DATASET_ID = process.env.META_DATASET_ID;
    const ACCESS_TOKEN = process.env.META_CAPI_ACCESS_TOKEN;
    const API_VERSION = process.env.META_API_VERSION || 'v25.0';

    if (!DATASET_ID || !ACCESS_TOKEN) {
      console.warn('META CONFIG MISSING');
      return { skipped: true };
    }

    const payload = {
      data: [
        {
          event_name: event.event_name || 'Lead',
          event_time: Math.floor(Date.now() / 1000),
          action_source: event.action_source || 'system_generated',
          event_source_url: event.event_source_url || undefined,
          user_data: buildUserData(event.user_data || {}),
          custom_data: event.custom_data || {}
        }
      ]
    };

    const url = `https://graph.facebook.com/${API_VERSION}/${DATASET_ID}/events?access_token=${encodeURIComponent(ACCESS_TOKEN)}`;

    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await response.json();

    if (!response.ok) {
      console.error('META ERROR', result);
      return { ok: false, error: result };
    }

    console.log('META EVENT SENT', event.event_name);
    return { ok: true, result };

  } catch (err) {
    console.error('META SEND FAILED', err);
    return { ok: false, error: err.message };
  }
}
