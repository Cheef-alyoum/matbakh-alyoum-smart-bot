"use strict";

const crypto = require("crypto");

const META_API_VERSION = process.env.META_API_VERSION || "v25.0";
const META_DATASET_ID = process.env.META_DATASET_ID || "1385933613086178";
const META_CAPI_ACCESS_TOKEN = process.env.META_CAPI_ACCESS_TOKEN || "";

/**
 * تحويل أي قيمة إلى نص منظف
 * @param {any} value
 * @returns {string|null}
 */
function cleanString(value) {
  if (value === null || value === undefined) return null;
  const result = String(value).trim();
  return result ? result : null;
}

/**
 * تشفير SHA256
 * @param {string} value
 * @returns {string}
 */
function sha256(value) {
  return crypto.createHash("sha256").update(value, "utf8").digest("hex");
}

/**
 * تنظيف البريد الإلكتروني قبل التشفير
 * @param {string|null|undefined} email
 * @returns {string|null}
 */
function normalizeEmail(email) {
  const value = cleanString(email);
  if (!value) return null;
  return value.toLowerCase();
}

/**
 * تنظيف رقم الهاتف قبل التشفير
 * أمثلة:
 * 0779960015 -> 962779960015
 * +962779960015 -> 962779960015
 * 962779960015 -> 962779960015
 * @param {string|null|undefined} phone
 * @returns {string|null}
 */
function normalizePhone(phone) {
  const value = cleanString(phone);
  if (!value) return null;

  let digits = value.replace(/[^\d]/g, "");

  if (digits.startsWith("00")) {
    digits = digits.slice(2);
  }

  if (digits.startsWith("0") && digits.length >= 9) {
    digits = "962" + digits.slice(1);
  }

  if (digits.length === 9 && digits.startsWith("7")) {
    digits = "962" + digits;
  }

  return digits || null;
}

/**
 * تنظيف الاسم الأول قبل التشفير
 * @param {string|null|undefined} firstName
 * @returns {string|null}
 */
function normalizeFirstName(firstName) {
  const value = cleanString(firstName);
  if (!value) return null;
  return value.toLowerCase();
}

/**
 * تنظيف الاسم الأخير قبل التشفير
 * @param {string|null|undefined} lastName
 * @returns {string|null}
 */
function normalizeLastName(lastName) {
  const value = cleanString(lastName);
  if (!value) return null;
  return value.toLowerCase();
}

/**
 * تنظيف المدينة قبل التشفير
 * @param {string|null|undefined} city
 * @returns {string|null}
 */
function normalizeCity(city) {
  const value = cleanString(city);
  if (!value) return null;
  return value.toLowerCase();
}

/**
 * إضافة حقل مجزأ إلى user_data
 * @param {object} userData
 * @param {string} key
 * @param {string|null} value
 */
function addHashedField(userData, key, value) {
  if (!value) return;
  userData[key] = [sha256(value)];
}

/**
 * بناء user_data وفق تنسيق Meta
 * @param {object} params
 * @param {string|number|null} [params.leadId]
 * @param {string|null} [params.email]
 * @param {string|null} [params.phone]
 * @param {string|null} [params.firstName]
 * @param {string|null} [params.lastName]
 * @param {string|null} [params.city]
 * @returns {object}
 */
function buildUserData({
  leadId = null,
  email = null,
  phone = null,
  firstName = null,
  lastName = null,
  city = null
} = {}) {
  const userData = {};

  const cleanLeadId = cleanString(leadId);
  if (cleanLeadId) {
    userData.lead_id = cleanLeadId;
  }

  addHashedField(userData, "em", normalizeEmail(email));
  addHashedField(userData, "ph", normalizePhone(phone));
  addHashedField(userData, "fn", normalizeFirstName(firstName));
  addHashedField(userData, "ln", normalizeLastName(lastName));
  addHashedField(userData, "ct", normalizeCity(city));

  return userData;
}

/**
 * إزالة القيم الفارغة من user_data
 * @param {object} userData
 * @returns {object}
 */
function pruneUserData(userData) {
  const result = {};

  for (const [key, value] of Object.entries(userData || {})) {
    if (value === null || value === undefined) continue;

    if (Array.isArray(value)) {
      if (value.length > 0) {
        result[key] = value;
      }
      continue;
    }

    if (typeof value === "string" && value.trim() !== "") {
      result[key] = value;
    }
  }

  return result;
}

/**
 * بناء الحمولة النهائية
 * @param {object} params
 * @param {string} params.eventName
 * @param {number} [params.eventTime]
 * @param {string} [params.leadEventSource]
 * @param {string|number|null} [params.leadId]
 * @param {string|null} [params.email]
 * @param {string|null} [params.phone]
 * @param {string|null} [params.firstName]
 * @param {string|null} [params.lastName]
 * @param {string|null} [params.city]
 * @param {string|null} [params.testEventCode]
 * @returns {object}
 */
function buildMetaCapiPayload({
  eventName,
  eventTime = Math.floor(Date.now() / 1000),
  leadEventSource = "Matbakh Al Youm CRM",
  leadId = null,
  email = null,
  phone = null,
  firstName = null,
  lastName = null,
  city = null,
  testEventCode = null
} = {}) {
  const cleanEventName = cleanString(eventName);
  if (!cleanEventName) {
    throw new Error("eventName is required");
  }

  const userData = pruneUserData(
    buildUserData({
      leadId,
      email,
      phone,
      firstName,
      lastName,
      city
    })
  );

  const payload = {
    data: [
      {
        action_source: "system_generated",
        event_name: cleanEventName,
        event_time: eventTime,
        custom_data: {
          event_source: "crm",
          lead_event_source: leadEventSource
        },
        user_data: userData
      }
    ]
  };

  const cleanTestEventCode = cleanString(testEventCode);
  if (cleanTestEventCode) {
    payload.test_event_code = cleanTestEventCode;
  }

  return payload;
}

/**
 * إنشاء رابط الإرسال إلى Meta
 * @returns {string}
 */
function buildMetaEndpoint() {
  if (!META_DATASET_ID) {
    throw new Error("META_DATASET_ID is missing");
  }

  if (!META_CAPI_ACCESS_TOKEN) {
    throw new Error("META_CAPI_ACCESS_TOKEN is missing");
  }

  return `https://graph.facebook.com/${META_API_VERSION}/${META_DATASET_ID}/events?access_token=${encodeURIComponent(META_CAPI_ACCESS_TOKEN)}`;
}

/**
 * إرسال حدث إلى Meta
 * @param {object} params
 * @returns {Promise<object>}
 */
async function sendMetaCapiEvent(params = {}) {
  const endpoint = buildMetaEndpoint();
  const payload = buildMetaCapiPayload(params);

  const response = await fetch(endpoint, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify(payload)
  });

  let result;
  try {
    result = await response.json();
  } catch (error) {
    result = {
      error: {
        message: "Invalid JSON response from Meta",
        details: error.message
      }
    };
  }

  if (!response.ok) {
    throw new Error(`Meta CAPI request failed: ${JSON.stringify(result)}`);
  }

  return {
    ok: true,
    status: response.status,
    endpoint,
    payload,
    result
  };
}

/**
 * حدث Lead
 * @param {object} params
 * @returns {Promise<object>}
 */
async function sendLeadEvent(params = {}) {
  return sendMetaCapiEvent({
    ...params,
    eventName: "Lead"
  });
}

/**
 * حدث OrderSubmitted
 * @param {object} params
 * @returns {Promise<object>}
 */
async function sendOrderSubmittedEvent(params = {}) {
  return sendMetaCapiEvent({
    ...params,
    eventName: "OrderSubmitted"
  });
}

/**
 * حدث Purchase
 * @param {object} params
 * @returns {Promise<object>}
 */
async function sendPurchaseEvent(params = {}) {
  return sendMetaCapiEvent({
    ...params,
    eventName: "Purchase"
  });
}

/**
 * حدث مخصص
 * @param {string} eventName
 * @param {object} params
 * @returns {Promise<object>}
 */
async function sendCustomEvent(eventName, params = {}) {
  return sendMetaCapiEvent({
    ...params,
    eventName
  });
}

module.exports = {
  META_API_VERSION,
  META_DATASET_ID,
  buildMetaEndpoint,
  sha256,
  cleanString,
  normalizeEmail,
  normalizePhone,
  normalizeFirstName,
  normalizeLastName,
  normalizeCity,
  buildUserData,
  buildMetaCapiPayload,
  sendMetaCapiEvent,
  sendLeadEvent,
  sendOrderSubmittedEvent,
  sendPurchaseEvent,
  sendCustomEvent
};
